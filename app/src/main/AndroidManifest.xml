<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- lire les SMS MVola deja recus (import de l'historique) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- recevoir les nouveaux SMS MVola meme quand l'app est fermee -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- petite notification "-500 Ar Credit" (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- onglet MVola : afficher les contacts du telephone (memes noms, recherche). Lecture seule -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- onglet MVola : composer le code USSD en un appui (sinon on ouvre juste le clavier du telephone) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- pas obligatoire : sans SMS on peut quand meme noter les especes -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".VolakoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Volako.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- raccourcis Envoyer / Retirer / Credit (appui long sur l'icone) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- remplissage automatique de la bulle Yas (description, "reprendre la session").
             BIND_ACCESSIBILITY_SERVICE : seul Android peut se connecter a ce service -->
        <service
            android:name=".ussd.UssdAutofillService"
            android:exported="false"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ussd_autofill_service" />
        </service>

        <!-- BROADCAST_SMS : seul le systeme peut nous envoyer ce message (securite) -->
        <receiver
            android:name=".sms.MvolaSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
